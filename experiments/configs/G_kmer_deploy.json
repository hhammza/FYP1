{
  "description": "Deploy candidate for /predict: LightGBM on 4-mers of the complete genome (v6, no plasmid records), threshold for VME <= 10% on validation",
  "data": {
    "genomes": "genomes_full",
    "min_genome_bp": 500000
  },
  "split": {
    "strategy": "grouped",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic"
    ],
    "kmers": {
      "k": 4,
      "extras": true
    }
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "vme_constrained",
    "vme_budget": 0.1
  },
  "evaluation": {
    "n_boot": 200
  }
}
