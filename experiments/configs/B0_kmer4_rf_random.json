{
  "description": "Shipped design on complete genomes: RF, 4-mers + antibiotic + GC/length, random row split",
  "data": {
    "genomes": "genomes_full"
  },
  "split": {
    "strategy": "random",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic"
    ],
    "kmers": {
      "k": 4,
      "extras": true
    }
  },
  "model": {
    "type": "random_forest",
    "params": {
      "n_estimators": 100,
      "max_depth": 15
    }
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  }
}
