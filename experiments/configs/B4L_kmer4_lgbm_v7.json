{
  "description": "B4 on the 24,926 genomes : LightGBM on 4-mers + antibiotic + GC/length [cleaning v7, plasmid-only records (< 500 kb) excluded]",
  "data": {
    "genomes": "genomes_full",
    "min_genome_bp": 500000
  },
  "split": {
    "strategy": "grouped",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic"
    ],
    "kmers": {
      "k": 4,
      "extras": true
    }
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  }
}
