{
  "description": "B8: train without Pseudomonas, test only on it (with gene features) [cleaning v7, plasmid-only records (< 500 kb) excluded]",
  "data": {
    "genomes": "gene_matrix",
    "min_genome_bp": 500000
  },
  "split": {
    "strategy": "species_holdout",
    "holdout_genus": "Pseudomonas"
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic",
      "drug_class"
    ],
    "genes": {
      "raw": true,
      "min_genomes": 50,
      "drug_aware": true
    }
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  }
}
