{
  "description": "Lab-tested genome set: antibiotic + drug class + genus (B6 without genes) [cleaning v7, plasmid-only records (< 500 kb) excluded]",
  "data": {
    "genomes": "gene_matrix",
    "min_genome_bp": 500000
  },
  "split": {
    "strategy": "grouped",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic",
      "drug_class",
      "genus"
    ]
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  }
}
