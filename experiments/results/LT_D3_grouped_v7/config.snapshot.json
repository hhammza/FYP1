{
  "description": "Lineage check for the tabular model D3_forecaster_deploy_v7 (Research track): its config on the 24,926 genomes with lineage clusters (no plasmid records), genome-grouped split (the twin of the lineage runs, same rows) [cleaning v7]",
  "data": {
    "taxon_level": "species",
    "source": "amr_full",
    "genomes": "genomes_full",
    "min_genome_bp": 500000
  },
  "split": {
    "strategy": "grouped",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "oof"
  },
  "model": {
    "type": "lightgbm",
    "monotone_on": [
      "mic_value",
      "mic_log"
    ]
  },
  "calibration": {
    "method": "isotonic"
  },
  "threshold": {
    "strategy": "vme_constrained",
    "vme_budget": 0.1
  },
  "evaluation": {
    "n_boot": 200
  },
  "id": "LT_D3_grouped_v7"
}