{
  "description": "Lineage check at scale, broad lineages held out: genes + antibiotic, drug class, genus",
  "data": {
    "source": "amr_output",
    "genomes": "gene_matrix"
  },
  "split": {
    "strategy": "lineage",
    "lineage_cut": "broad",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
    "target_encoding": "none",
    "base": [
      "Antibiotic",
      "drug_class",
      "genus"
    ],
    "genes": {
      "raw": true,
      "min_genomes": 50,
      "drug_aware": true
    }
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  },
  "id": "LL_broad_genes"
}