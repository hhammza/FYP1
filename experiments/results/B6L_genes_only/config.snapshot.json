{
  "description": "Genes and drug-aware features + antibiotic and drug class only, no genus: does the gene signal stand alone?",
  "data": {
    "source": "amr_output",
    "genomes": "gene_matrix"
  },
  "split": {
    "strategy": "grouped",
    "test_size": 0.2,
    "seed": 42
  },
  "features": {
