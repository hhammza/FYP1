      "Antibiotic",
      "drug_class"
    ],
    "genes": {
      "raw": true,
      "min_genomes": 50,
      "drug_aware": true
    }
  },
  "model": {
    "type": "lightgbm"
  },
  "threshold": {
    "strategy": "fixed",
    "fixed": 0.5
  },
  "evaluation": {
    "n_boot": 200
  },
  "id": "B6L_genes_only"
}