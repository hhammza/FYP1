# ============================================================
# AMR Intelligence Platform — .gitignore
# ============================================================
# What IS committed:  all source code, templates, CSS/JS,
#                     requirements.txt, notebooks, .md docs,
#                     .bat scripts, fasta_amr_map.py
#
# What is NOT committed (listed below):
#   - Raw datasets (too large — thousands of files, GBs of data)
#   - Trained model artifacts (can be regenerated by train_models.py)
#   - Python cache and build artifacts
#   - IDE/editor folders
#   - Database files
#   - Temp/cache directories
# ============================================================


# ------------------------------------------------------------
# DATASETS — Raw training data (GBs of files, not source code)
# ------------------------------------------------------------

# BVBRC AMR CSV files (3,655+ files, ~90K records)
amr_output/

# NCBI GenBank WGS FASTA sequences (1,684 folders, 2,587 FASTA files)
fasta_output/

# Joined AMR + genome records (1,684 mapped CSV files)
mapped_output/

# Sample/dev subsets of the above datasets
sample_amr_data/
sample_fasta_output/
sample_mapped_output/

# K-mer frequency cache files (pre-computed .npy arrays, regenerable)
kmer_cache/
sample_kmer_cache/
*.k4.npy


# ------------------------------------------------------------
# TRAINED MODEL ARTIFACTS
# Generated by: python train_models.py --model all
# Excluded because: large binary/text files, regenerable from source
# To regenerate: cd backend && python train_models.py --model all
# ------------------------------------------------------------

backend/trained_models/amr_lgbm_final_model.txt
backend/trained_models/kmer_resistance_model.pkl
backend/trained_models/*.joblib

# Keras/TF model from earlier experiments (not used in current system)
*.h5
*.keras


# ------------------------------------------------------------
# PYTHON CACHE & BUILD ARTIFACTS
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# pytest
.pytest_cache/
.cache/

# mypy / type stubs
.mypy_cache/
.dmypy.json

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml


# ------------------------------------------------------------
# VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------

venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/


# ------------------------------------------------------------
# ENVIRONMENT & SECRET FILES
# ------------------------------------------------------------

.env
.env.local
.env.*.local
*.secret
secrets.json


# ------------------------------------------------------------
# DATABASE FILES
# ------------------------------------------------------------

# Django's SQLite database (only used for migrations, no prediction data)
backend/db.sqlite3
*.sqlite3
*.db


# ------------------------------------------------------------
# JUPYTER NOTEBOOK ARTIFACTS
# (Notebooks themselves ARE committed — only checkpoints excluded)
# ------------------------------------------------------------

.ipynb_checkpoints/
*/.ipynb_checkpoints/


# ------------------------------------------------------------
# IDE & EDITOR FILES
# ------------------------------------------------------------

# VS Code
.vscode/

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml

# Sublime Text
*.sublime-workspace

# Vim/Emacs swap files
*.swp
*.swo
*~


# ------------------------------------------------------------
# OS-GENERATED FILES
# ------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*


# ------------------------------------------------------------
# CLAUDE CODE INTERNAL FILES
# ------------------------------------------------------------

.claude/


# ------------------------------------------------------------
# LARGE BINARY DOCUMENTS
# (Share these separately — not source code, not needed in repo)
# ------------------------------------------------------------

*.pdf
*.docx
*.doc
*.pptx


# ------------------------------------------------------------
# LOGS & TEMP FILES
# ------------------------------------------------------------

*.log
*.tmp
*.temp
logs/
log/


# ------------------------------------------------------------
# TRAINED MODELS DIRECTORY — keep the folder, not the files
# A .gitkeep file is committed so the empty folder exists in git.
# Run train_models.py to populate it after cloning.
# ------------------------------------------------------------
backend/trained_models/*
!backend/trained_models/.gitkeep
